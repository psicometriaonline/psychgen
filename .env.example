# Copy this file to `.env` and fill in real values.

# ---- Postgres ----
POSTGRES_USER=psychgen
POSTGRES_PASSWORD=psychgen
POSTGRES_DB=psychgen
POSTGRES_PORT=5432

# ---- AI providers ----
# Use ONE of: direct keys (OPENAI_API_KEY / ANTHROPIC_API_KEY) OR the Replit
# AI integrations proxy (AI_INTEGRATIONS_*).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=

# ---- Service ports (host side) ----
R_ENGINE_PORT=8000
API_PORT=8080
WEB_PORT=5173

# ---- Build da imagem R (avançado — não precisa mexer) ----
# Versão do R. Precisa ser >= 4.5 (pacotes do snapshot usam a API C do R 4.5).
# Se o build falhar compilando algum pacote do zero, tente 4.6.1 aqui.
R_VERSION=4.5.3
# Data do snapshot do CRAN. Trava as versões dos pacotes R para que o build
# seja sempre reprodutível.
CRAN_SNAPSHOT=2026-08-03
# Commit específico do AIGENIE. Vazio = instala a versão publicada no
# r-universe, que é o recomendado.
AIGENIE_GIT_REF=

# ---- Web build ----
# Path to the API as seen by the browser. Default works because nginx proxies
# /api/* to the api service.
VITE_API_URL=/api
